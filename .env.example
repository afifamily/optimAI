# optimAI configuration — copy to .env and adjust.
# Validated in CLI session #2 (2026-05-19, post-Osaurus-bascule).

# MLX inference server (DEC-017)
# Run with:
#   mlx_lm.server --model mlx-community/Qwen2.5-Coder-32B-Instruct-4bit \
#                 --host 127.0.0.1 --port 1337 --log-level INFO
# Loopback only (DEC-012). Never use --host 0.0.0.0.
MLX_SERVER_URL=http://127.0.0.1:1337/v1
MLX_SERVER_PORT=1337

# Worker model (DEC-018)
# Use the exact id returned by /v1/models. Default below.
OPTIMAI_MODEL=mlx-community/Qwen2.5-Coder-32B-Instruct-4bit

# Worker limits (DEC-007)
OPTIMAI_MAX_ITERATIONS=10
OPTIMAI_TIMEOUT_SECONDS=300
OPTIMAI_MAX_OUTPUT_BYTES=10240

# Security (DEC-008, DEC-012)
OPTIMAI_BLACKLIST_FILE=config/blacklist.txt
OPTIMAI_SANDBOX_STRICT=true

# Logging
OPTIMAI_LOG_LEVEL=INFO
OPTIMAI_LOG_FILE=logs/optimai.log
